#!/usr/bin/env python3
"""Run one or more stable audit designs against a target repository.

Execution backends (plan sections 1-2):

- ``--execution-backend host``   scaffold + host-native queue; the calling
  agent's own subagents execute prompts (never local Codex/Claude CLIs).
- ``--execution-backend codex``  subprocess Codex CLI workers (CLI default).
- ``--execution-backend claude`` subprocess Claude Code workers.

Suites live under ``<target-repo>/.dlt-auditor-work/<suite-name>/`` by
default; legacy suites under ``<repo>/runs/`` resume in place.
"""

from __future__ import annotations

import argparse
import datetime as dt
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from runtime.backends import (  # noqa: E402
    BACKENDS,
    BackendError,
    DEFAULT_DEEP_PHASES,
    DEFAULT_DEEP_REASONING_EFFORT,
    DEFAULT_PARALLEL_JOBS,
    DEFAULT_REASONING_EFFORT,
    DEFAULT_SERVICE_TIER,
    REASONING_EFFORT_CHOICES,
    SERVICE_TIER_CHOICES,
    build_runner_command,
    resolve_backend,
    worker_script,
)
from runtime.hostqueue import command_status  # noqa: E402
from runtime.suite import (  # noqa: E402
    LIMIT_EXHAUSTED_EXIT_CODE,
    LEGACY_RUNS_DIR,
    read_json,
    scaffold_suite,
    suite_item_dir,
    update_json,
    write_suite_manifest,
    write_suite_readme,
)
from runtime.workspace import (  # noqa: E402
    default_work_root,
    ensure_suite_layout,
    print_gitignore_hint,
    resolve_suite_dir,
    update_gitignore,
    utc_now,
)

RUNNER_PHASE_CHOICES = ("all", "mapper", "corpus", "scans", "canonicalize", "validations", "aggregate", "final")


def suite_settings_from_args(args: argparse.Namespace, backend: str) -> dict:
    return {
        "execution_backend": backend,
        "parallel_jobs": args.parallel_jobs,
        "model": args.model or "",
        "service_tier": args.service_tier,
        "reasoning_effort": args.reasoning_effort,
        "deep_reasoning_effort": args.deep_reasoning_effort,
        "deep_phases": args.deep_phases,
        "codex_path": args.codex_path or "",
        "claude_path": args.claude_path or "",
        "claude_add_dirs": [str(Path(path).expanduser().resolve()) for path in (args.claude_add_dir or [])],
        "timeout_seconds": args.timeout_seconds,
        "skip_login_check": args.skip_login_check,
        "previous_ref": args.previous_ref or "",
        "current_ref": args.current_ref or "",
    }


def load_suite_args(args: argparse.Namespace, backend: str) -> tuple[str, Path, list[str], dict, Path, bool]:
    if args.resume and not args.suite_name:
        raise SystemExit("--suite-name is required with --resume")
    if args.resume and args.force:
        raise SystemExit("--resume and --force cannot be used together")

    suite_slug = args.suite_name.strip() if args.suite_name else ""
    work_root_arg = Path(args.work_root).expanduser().resolve() if args.work_root else None

    resolution = None
    if suite_slug:
        # Target repo order: --repo, then the new work root's manifest, then legacy.
        target_value = args.repo
        if not target_value and work_root_arg:
            manifest = read_json(work_root_arg / suite_slug / "suite-manifest.json")
            target_value = manifest.get("target_repo")
        if not target_value:
            legacy_manifest = read_json(LEGACY_RUNS_DIR / suite_slug / "suite-manifest.json")
            target_value = legacy_manifest.get("target_repo")
        if not target_value and not args.resume:
            raise SystemExit("--repo is required for a new blind suite")
        if not target_value:
            raise SystemExit(f"Cannot locate suite `{suite_slug}`; pass --repo or --work-root")
        target = Path(str(target_value)).expanduser().resolve()
        if not target.is_dir():
            raise SystemExit(f"Target repo does not exist: {target}")
        resolution = resolve_suite_dir(
            repo=target,
            suite_name=suite_slug,
            work_root=work_root_arg or default_work_root(target),
            legacy_runs_dir=LEGACY_RUNS_DIR,
        )
        if args.resume and not resolution.suite_dir.is_dir():
            raise SystemExit(f"Blind suite not found: {resolution.suite_dir}")
        if resolution.legacy:
            print(f"warning: {resolution.message}", file=sys.stderr)
    else:
        if not args.repo:
            raise SystemExit("--repo is required for a new blind suite")
        target = Path(args.repo).expanduser().resolve()
        if not target.is_dir():
            raise SystemExit(f"Target repo does not exist: {target}")
        suite_slug = f"{dt.datetime.now(dt.UTC):%Y%m%d-%H%M%SZ}-{target.name}-blind-suite"
        resolution = resolve_suite_dir(
            repo=target,
            suite_name=suite_slug,
            work_root=work_root_arg,
            legacy_runs_dir=LEGACY_RUNS_DIR,
        )

    suite_dir = resolution.suite_dir
    manifest_file = suite_dir / "suite-manifest.json"
    previous_manifest = read_json(manifest_file) if manifest_file.is_file() else {}

    designs = [design.strip() for design in (args.design or previous_manifest.get("designs") or []) if design.strip()]
    designs = ["".join(ch if ch.isalnum() or ch == "-" else "-" for ch in d.lower()) or "run" for d in designs]
    if not designs:
        raise SystemExit("--design is required for a new blind suite; repeat it once per design")
    if len(set(designs)) != len(designs):
        raise SystemExit("Blind suite design names must be unique")
    if args.resume and args.design and designs != previous_manifest.get("designs"):
        raise SystemExit("Resume must use the design list recorded in the existing suite manifest")

    settings = previous_manifest.get("settings") if args.resume and previous_manifest else None
    if not isinstance(settings, dict):
        settings = suite_settings_from_args(args, backend)
    return suite_slug, target, designs, settings, suite_dir, resolution.legacy


def execute_audit_for_item(
    item_dir: Path,
    design_copy: Path,
    audit_run: Path,
    *,
    target: Path,
    parallel_jobs: int,
    resume: bool,
    phase: str,
    settings: dict,
) -> int:
    runner = worker_script(design_copy)
    if not runner.is_file():
        print(f"Automatic execution needs a runner: {runner}", file=sys.stderr)
        return 2

    backend = str(settings.get("execution_backend") or "codex")
    claude_dirs = [target, design_copy] if backend == "claude" else []
    claude_dirs.extend(str(path) for path in settings.get("claude_add_dirs", []))
    seen: set[str] = set()
    add_dirs: list[Path] = []
    for raw in claude_dirs:
        resolved = str(Path(raw).expanduser().resolve())
        if resolved not in seen:
            seen.add(resolved)
            add_dirs.append(Path(resolved))
    command = build_runner_command(
        backend=backend,
        runner=runner,
        audit_run=audit_run,
        parallel_jobs=parallel_jobs,
        resume=resume,
        phase=phase,
        model=str(settings.get("model") or "") or None,
        service_tier=str(settings.get("service_tier") or DEFAULT_SERVICE_TIER),
        reasoning_effort=str(settings.get("reasoning_effort") or DEFAULT_REASONING_EFFORT),
        deep_reasoning_effort=str(settings.get("deep_reasoning_effort") or DEFAULT_DEEP_REASONING_EFFORT),
        deep_phases=str(settings.get("deep_phases") or DEFAULT_DEEP_PHASES),
        codex_path=str(settings.get("codex_path") or "") or None,
        claude_path=str(settings.get("claude_path") or "") or None,
        claude_add_dirs=add_dirs,
        timeout_seconds=settings.get("timeout_seconds"),
        skip_login_check=bool(settings.get("skip_login_check")),
    )

    manifest_path = item_dir / "item-manifest.json"
    update_json(
        manifest_path,
        status="audit_running",
        audit_status="running",
        audit_runner=str(runner),
        audit_command=command,
        audit_started_at_utc=utc_now(),
    )
    completed = subprocess.run(command, text=True, check=False)
    if completed.returncode == 0:
        update_json(
            manifest_path,
            status="audit_completed",
            audit_status="completed",
            audit_completed_at_utc=utc_now(),
            audit_last_returncode=0,
        )
        return 0
    if completed.returncode == LIMIT_EXHAUSTED_EXIT_CODE:
        update_json(
            manifest_path,
            status="limit_exhausted",
            audit_status="limit_exhausted",
            audit_last_returncode=completed.returncode,
            audit_interrupted_at_utc=utc_now(),
        )
        write_resume_instructions(item_dir, audit_run, runner, parallel_jobs, settings)
        print(f"Audit paused because worker limits appear exhausted: {item_dir / 'RESUME.md'}")
        return 0

    update_json(
        manifest_path,
        status="audit_failed",
        audit_status="failed",
        audit_last_returncode=completed.returncode,
        audit_failed_at_utc=utc_now(),
    )
    return completed.returncode


def write_resume_instructions(
    item_dir: Path,
    audit_run: Path,
    runner: Path,
    parallel_jobs: int,
    settings: dict,
) -> None:
    backend = str(settings.get("execution_backend") or "codex")
    command = build_runner_command(
        backend=backend,
        runner=runner,
        audit_run=audit_run,
        parallel_jobs=parallel_jobs,
        resume=True,
        phase="all",
        model=str(settings.get("model") or "") or None,
        service_tier=str(settings.get("service_tier") or DEFAULT_SERVICE_TIER),
        reasoning_effort=str(settings.get("reasoning_effort") or DEFAULT_REASONING_EFFORT),
        deep_reasoning_effort=str(settings.get("deep_reasoning_effort") or DEFAULT_DEEP_REASONING_EFFORT),
        deep_phases=str(settings.get("deep_phases") or DEFAULT_DEEP_PHASES),
        codex_path=str(settings.get("codex_path") or "") or None,
        claude_path=str(settings.get("claude_path") or "") or None,
        claude_add_dirs=[Path(str(path)) for path in settings.get("claude_add_dirs", [])],
        timeout_seconds=settings.get("timeout_seconds"),
        skip_login_check=bool(settings.get("skip_login_check")),
    )
    (item_dir / "RESUME.md").write_text(
        f"""# Resume Interrupted Audit

The audit run paused before completion, most likely because worker quota or rate limits were exhausted.

Completed worker prompts are checkpointed under:

```text
{audit_run / "agent-logs" / "runner-state"}
```

Resume the suite without recreating completed design items:

```bash
bin/run-blind-suite --suite-name {item_dir.parents[1].name} --resume
```

Lower-level runner command:

```bash
{" ".join(command)}
```
""",
        encoding="utf-8",
    )


def command_run_blind_suite(args: argparse.Namespace) -> int:
    if args.list_designs:
        for design in list_designs():
            print(design)
        return 0

    try:
        backend = resolve_backend(execution_backend=args.execution_backend, agent=args.agent)
    except BackendError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    suite_slug, target, designs, settings, suite_dir, legacy = load_suite_args(args, backend)
    if suite_dir.exists() and not args.resume:
        if not args.force:
            print(f"Blind suite already exists: {suite_dir}", file=sys.stderr)
            print("Use --resume to continue it or --force to replace it.", file=sys.stderr)
            return 2
        import shutil

        shutil.rmtree(suite_dir)
    suite_existed = suite_dir.exists()
    if not legacy:
        ensure_suite_layout(suite_dir)
    if not suite_existed:
        if args.update_gitignore:
            update_gitignore(target)
        else:
            print_gitignore_hint(target)

    created_at = None if args.resume else utc_now()
    manifest = write_suite_manifest(
        suite_dir,
        suite_name=suite_slug,
        target=target,
        designs=designs,
        status="running",
        settings=settings,
        created_at_utc=created_at,
        work_root=suite_dir.parent,
        legacy=legacy,
    )
    write_suite_readme(suite_dir, manifest)

    if backend == "host":
        scaffold_suite(
            suite_dir=suite_dir,
            suite_name=suite_slug,
            target=target,
            designs=designs,
            settings=settings,
            resume=args.resume,
            force=args.force,
            legacy_layout=legacy,
        )
        if args.resume:
            from runtime.hostqueue import load_queue as load_host_queue

            load_host_queue(suite_dir, recover=True)
        status = command_status(suite_dir)
        print(f"Host-native suite scaffolded: {suite_dir}")
        print(f"Execution backend: host (no local Codex/Claude CLI workers will be started)")
        print(f"Next phase: {status['phase']} ({len(status['pending'])} tasks pending, max concurrency {status['max_concurrency']})")
        print("Drive execution with:")
        print(f"  bin/host-runner {suite_dir} next --limit {status['max_concurrency']}")
        print(f"  bin/host-runner {suite_dir} status")
        return 0

    for index, design_name in enumerate(designs, start=1):
        item_dir = suite_item_dir(suite_dir, index, design_name)
        item_manifest_path = item_dir / "item-manifest.json"
        if item_manifest_path.is_file():
            item_manifest = read_json(item_manifest_path)
            if item_manifest.get("audit_status") == "completed":
                manifest = write_suite_manifest(
                    suite_dir,
                    suite_name=suite_slug,
                    target=target,
                    designs=designs,
                    status="running",
                    settings=settings,
                    message=f"Skipped completed design `{design_name}`.",
                    work_root=suite_dir.parent,
                    legacy=legacy,
                )
                write_suite_readme(suite_dir, manifest)
                continue
            if not args.resume and not args.force:
                print(f"Suite item already exists: {item_dir}", file=sys.stderr)
                return 2
            audit_run = Path(str(item_manifest.get("audit_run", ""))).expanduser().resolve()
            design_copy = Path(str(item_manifest.get("source_design_dir", ""))).expanduser().resolve()
        else:
            from runtime.suite import scaffold_suite_item

            item_dir, design_copy, audit_run = scaffold_suite_item(
                suite_dir=suite_dir,
                index=index,
                design_name=design_name,
                target=target,
                settings=settings,
                force=args.force,
                legacy_layout=legacy,
            )

        if args.scaffold_only:
            manifest = write_suite_manifest(
                suite_dir,
                suite_name=suite_slug,
                target=target,
                designs=designs,
                status="scaffolded",
                settings=settings,
                message="Suite scaffolded without execution.",
                work_root=suite_dir.parent,
                legacy=legacy,
            )
            write_suite_readme(suite_dir, manifest)
            continue

        result = execute_audit_for_item(
            item_dir,
            design_copy,
            audit_run,
            target=target,
            parallel_jobs=int(settings.get("parallel_jobs") or DEFAULT_PARALLEL_JOBS),
            resume=args.resume and item_manifest_path.is_file(),
            phase=args.phase,
            settings=settings,
        )
        item_manifest = read_json(item_manifest_path)
        if item_manifest.get("audit_status") == "limit_exhausted":
            manifest = write_suite_manifest(
                suite_dir,
                suite_name=suite_slug,
                target=target,
                designs=designs,
                status="limit_exhausted",
                settings=settings,
                message=f"Paused while running `{design_name}`. Resume with --resume.",
                work_root=suite_dir.parent,
                legacy=legacy,
            )
            write_suite_readme(suite_dir, manifest)
            print(f"Blind suite paused because worker limits appear exhausted: {suite_dir / 'README.md'}")
            return 0
        if result != 0 or item_manifest.get("audit_status") == "failed":
            manifest = write_suite_manifest(
                suite_dir,
                suite_name=suite_slug,
                target=target,
                designs=designs,
                status="failed",
                settings=settings,
                message=f"Stopped after `{design_name}` failed.",
                work_root=suite_dir.parent,
                legacy=legacy,
            )
            write_suite_readme(suite_dir, manifest)
            return result or int(item_manifest.get("audit_last_returncode") or 1)

        manifest = write_suite_manifest(
            suite_dir,
            suite_name=suite_slug,
            target=target,
            designs=designs,
            status="running",
            settings=settings,
            message=f"Completed `{design_name}`.",
            work_root=suite_dir.parent,
            legacy=legacy,
        )
        write_suite_readme(suite_dir, manifest)

    final_status = "scaffolded" if args.scaffold_only else "completed"
    manifest = write_suite_manifest(
        suite_dir,
        suite_name=suite_slug,
        target=target,
        designs=designs,
        status=final_status,
        settings=settings,
        message="Blind suite completed." if not args.scaffold_only else "Blind suite scaffolded.",
        work_root=suite_dir.parent,
        legacy=legacy,
    )
    write_suite_readme(suite_dir, manifest)
    print(suite_dir)
    return 0


def list_designs() -> list[str]:
    from runtime.suite import list_designs as _list

    return _list()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list-designs", action="store_true", help="List runnable designs and exit.")
    parser.add_argument("--repo", help="Target repository path. Required for a new suite.")
    parser.add_argument(
        "--design",
        action="append",
        help="Design folder name under designs/. Repeat once per design.",
    )
    parser.add_argument("--suite-name", help="Stable folder name under the target's .dlt-auditor-work/.")
    parser.add_argument(
        "--execution-backend",
        choices=BACKENDS,
        default=None,
        help=(
            "How audit prompts are executed: host = the calling agent's own subagents (never local "
            "Codex/Claude CLIs); codex = subprocess Codex CLI workers (default for direct CLI use); "
            "claude = subprocess Claude Code workers."
        ),
    )
    parser.add_argument(
        "--agent",
        choices=("codex", "claude"),
        default=None,
        help="Deprecated alias for --execution-backend codex|claude.",
    )
    parser.add_argument(
        "--work-root",
        help="Custom work root for suite output. Defaults to <target-repo>/.dlt-auditor-work/.",
    )
    parser.add_argument(
        "--parallel-jobs",
        type=int,
        default=DEFAULT_PARALLEL_JOBS,
        help=f"Maximum concurrent workers (default: {DEFAULT_PARALLEL_JOBS}).",
    )
    parser.add_argument("--previous-ref")
    parser.add_argument("--current-ref")
    parser.add_argument("--model", help="Explicit worker model. Default: never override the backend's own model choice.")
    parser.add_argument("--service-tier", choices=SERVICE_TIER_CHOICES, default=DEFAULT_SERVICE_TIER)
    parser.add_argument("--codex-path")
    parser.add_argument("--claude-path")
    parser.add_argument(
        "--claude-add-dir",
        action="append",
        default=[],
        help="Additional directory to grant Claude Code access to. Can be repeated.",
    )
    parser.add_argument("--timeout-seconds", type=int)
    parser.add_argument("--skip-login-check", action="store_true")
    parser.add_argument("--reasoning-effort", choices=REASONING_EFFORT_CHOICES, default=DEFAULT_REASONING_EFFORT)
    parser.add_argument(
        "--deep-reasoning-effort",
        choices=REASONING_EFFORT_CHOICES,
        default=DEFAULT_DEEP_REASONING_EFFORT,
    )
    parser.add_argument("--deep-phases", default=DEFAULT_DEEP_PHASES)
    parser.add_argument("--phase", choices=RUNNER_PHASE_CHOICES, default="all")
    parser.add_argument("--resume", action="store_true", help="Continue an existing suite and skip completed designs.")
    parser.add_argument("--scaffold-only", action="store_true", help="Create isolated design runs without launching workers.")
    parser.add_argument("--force", action="store_true", help="Replace an existing suite when not using --resume.")
    parser.add_argument(
        "--update-gitignore",
        action="store_true",
        help=(
            "Opt-in: append `.dlt-auditor-work/` to the target repo's .gitignore when creating the work root. "
            "By default dlt-auditor only prints a hint and never modifies the target repo."
        ),
    )
    return parser


def main() -> int:
    args = build_parser().parse_args()
    return command_run_blind_suite(args)


if __name__ == "__main__":
    raise SystemExit(main())
